# Path to the folder in which the `docker-compose.yaml` resides
PROJECT_DIR=/path/to/project/dir

# Generic
TELEMETRY_API_URL=http://telemetry-api:8000

# Settings for the `audiothek-downloader` service
AUDIOTHEK_DOWNLOADER_APP_DIR=/home/jdoe/.local/share/audiothek-downloader/
PODCAST_STORAGE_DIR=/path/to/podcast/dir

# Settings for the `backup-storage` service
BACKUP_SOURCE_DIR=/path/to/storage/dir
BACKUP_MIRROR_DIR=/path/to/backup/dir

# Settings for the `sync-gdrive` service
RCLONE_CONFIG_DIR=/home/jdoe/.config/rclone
GDRIVE_SOURCE=gdrive:Folder
HOST_SYNC_DIR=/path/to/local/sync/dir
