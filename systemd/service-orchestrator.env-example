# Path to the folder in which the `docker-compose.yaml` resides
PROJECT_DIR=/path/to/project/dir

# Generic
TELEMETRY_API_URL=http://telemetry-api:8000

# Settings for the `audiothek-downloader` service
AUDIOTHEK_DOWNLOADER_APP_DIR=/home/jdoe/.local/share/audiothek-downloader/
PODCAST_STORAGE_DIR=/path/to/podcast/dir

# Settings for the `backup-home-files` service
BACKUP_HOME_FILES_SRC_DIR=/home/jdoe
BACKUP_HOME_FILES_DEST_DIR=/path/to/backup/dir
BACKUP_HOME_FILES_FROM=path-to-include-files.txt

# Settings for the `backup-postgres` service
DB_BACKUP_DESTINATION=/path/to/backup/dir
DATABASE_HOST=postgres
DATABASE_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Settings for the `backup-storage` service
BACKUP_SOURCE_DIR=/path/to/storage/dir
BACKUP_MIRROR_DIR=/path/to/backup/dir

# Settings for the `document-router` service
DOCUMENT_SOURCE_DIR=/path/to/document/source
DOCUMENT_STORAGE_DIR=/path/to/document/storage

# Settings for the `photo-router` service
PHOTO_SOURCE_DIR=/path/to/photo/source
PHOTO_STORAGE_DIR=/path/to/photo/storage

# Settings for the `sync-gdrive` service
RCLONE_CONFIG_DIR=/home/jdoe/.config/rclone
GDRIVE_SOURCE=gdrive:Folder
HOST_SYNC_DIR=/path/to/local/sync/dir
